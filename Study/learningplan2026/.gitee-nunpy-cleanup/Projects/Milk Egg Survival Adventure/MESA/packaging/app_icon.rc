// 奶蛋求生应用图标与版本信息
// 在 MESA 项目中添加此文件；相对路径以 MESA 项目目录为基准
#pragma code_page(65001)
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// ID 1 同时用于游戏窗口 LoadImageW 与 EXE 默认图标
1 ICON "packaging\\game.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "奶蛋求生"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MESA"
            VALUE "OriginalFilename", "奶蛋求生.exe"
            VALUE "ProductName", "奶蛋求生"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

