diff --git a/bin/create_tifs.sh b/bin/create_tifs.sh
index 4ace467..6d256e7 100755
--- a/bin/create_tifs.sh
+++ b/bin/create_tifs.sh
@@ -1,8 +1,13 @@
 #!/bin/bash
 
-cd `python -c "import histonet; print(histonet.config.SPATIAL_RAW_ROOT)"`
+set -euo pipefail
+cd "$(python -c 'import stnet; print(stnet.config.SPATIAL_RAW_ROOT)')"
+shopt -s nullglob
 for i in */*/*.jpg;
 do
-    echo ${i}
-    convert ${i} -define tiff:tile-geometry=256x256 ${i%.jpg}.tif
+    if [ ! -f "${i%.jpg}.tif" ]; then
+        echo "$i"
+        vips tiffsave "$i" "${i%.jpg}.partial.tif" --tile --tile-width 256 --tile-height 256 --compression deflate
+        mv "${i%.jpg}.partial.tif" "${i%.jpg}.tif"
+    fi
 done
